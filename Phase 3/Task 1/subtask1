import cv2
import matplotlib.pyplot as plt

# Read the image
image = cv2.imread("noisy.jpg")

# Convert BGR to RGB for matplotlib
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# 1. Average Blur
average = cv2.blur(image, (5, 5))

# Canny on Average Blur
average_gray = cv2.cvtColor(average, cv2.COLOR_BGR2GRAY)
average_edges = cv2.Canny(average_gray, 50, 150)


# 2. Median Blur

median = cv2.medianBlur(image, 5)

# Canny on Median Blur
median_gray = cv2.cvtColor(median, cv2.COLOR_BGR2GRAY)
median_edges = cv2.Canny(median_gray, 50, 150)


# 3. Gaussian Blur

gaussian = cv2.GaussianBlur(image, (5, 5), 0)

# Canny on Gaussian Blur
gaussian_gray = cv2.cvtColor(gaussian, cv2.COLOR_BGR2GRAY)
gaussian_edges = cv2.Canny(gaussian_gray, 50, 150)

# Convert denoised images to RGB
average_rgb = cv2.cvtColor(average, cv2.COLOR_BGR2RGB)
median_rgb = cv2.cvtColor(median, cv2.COLOR_BGR2RGB)
gaussian_rgb = cv2.cvtColor(gaussian, cv2.COLOR_BGR2RGB)


# Display everything

plt.figure(figsize=(15, 10))

plt.subplot(2, 4, 1)
plt.imshow(image_rgb)
plt.title("Original")
plt.axis("off")

plt.subplot(2, 4, 2)
plt.imshow(average_rgb)
plt.title("Average Blur")
plt.axis("off")

plt.subplot(2, 4, 3)
plt.imshow(average_edges, cmap="gray")
plt.title("Average + Canny")
plt.axis("off")

plt.subplot(2, 4, 4)
plt.imshow(median_rgb)
plt.title("Median Blur")
plt.axis("off")

plt.subplot(2, 4, 5)
plt.imshow(median_edges, cmap="gray")
plt.title("Median + Canny")
plt.axis("off")

plt.subplot(2, 4, 6)
plt.imshow(gaussian_rgb)
plt.title("Gaussian Blur")
plt.axis("off")

plt.subplot(2, 4, 7)
plt.imshow(gaussian_edges, cmap="gray")
plt.title("Gaussian + Canny")
plt.axis("off")

plt.tight_layout()
plt.show()
