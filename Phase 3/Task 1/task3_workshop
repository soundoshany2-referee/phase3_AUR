import cv2
import numpy as np

image = cv2.imread("task3.jpeg")

gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

blur = cv2.GaussianBlur(gray, (5, 5), 0)

edges = cv2.Canny(blur, 50, 150)

contours, hierarchy = cv2.findContours( edges, cv2.RETR_EXTERNAL,  cv2.CHAIN_APPROX_SIMPLE)


counts = {
    "Triangle": 0,
    "Square": 0,
    "Rectangle": 0,
    "Circle": 0
    }

result = image.copy()

for contour in contours:

    area = cv2.contourArea(contour)

    if area < 500:
        continue

    perimeter = cv2.arcLength(contour, True)

    approx = cv2.approxPolyDP(contour,0.04 * perimeter, True )

    vertices = len(approx)

    if vertices == 3:
        shape = "Triangle"

    elif vertices == 4:

        x, y, w, h = cv2.boundingRect(approx)

        aspect_ratio = w / float(h)

        if 0.90 <= aspect_ratio <= 1.10:
            shape = "Square"
        else:
            shape = "Rectangle"

    else:
        shape = "Circle"

    counts[shape] += 1

    moments = cv2.moments(contour)

    if moments["m00"] != 0:
        cx = int(moments["m10"] / moments["m00"])
        cy = int(moments["m01"] / moments["m00"])
    else:
        continue

    cv2.drawContours(result,[contour],-1,(0, 255, 0) ,  2)

    cv2.putText(result,shape,(cx - 40, cy),cv2.FONT_HERSHEY_SIMPLEX, 0.6,(255, 0, 0),2)

print("Shape Counts:")
print("Triangles:", counts["Triangle"])
print("Squares:", counts["Square"])
print("Rectangles:", counts["Rectangle"])
print("Circles:", counts["Circle"])

cv2.imshow("Shape Detection", result)

cv2.waitKey(0)
cv2.destroyAllWindows()
